TRACKING_SERVICE_TOKEN=
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_TREASURY_ADDRESS=
# JSON array or base58 secret key; never commit a real private key.
SOLANA_TREASURY_PRIVATE_KEY=
SOLANA_PLATFORM_FEE_WALLET_ADDRESS=
SOLANA_COMPANY_DEPOSIT_FEE_BPS=100
SOLANA_COMPANY_WITHDRAWAL_FEE_BPS=100
SOLANA_CREATOR_WITHDRAWAL_FEE_BPS=100
SOLANA_MAX_WITHDRAWAL_LAMPORTS=10000000000
SOLANA_DAILY_WITHDRAWAL_LIMIT_LAMPORTS=50000000000
SOLANA_INTERNAL_CURRENCY_PER_SOL=1
# clipfi_escrow program id on Devnet.
SOLANA_ESCROW_PROGRAM_ID=GAXMVFUXzAPBwhW4cF127HiSZmiY791XX2mBFEqqBwx
# Path to clipfi_escrow.json (Anchor IDL); relative paths resolve against the backend dir.
# Default lookup: ../clipfi/idl/clipfi_escrow.json (mounted at /clipfi/idl in docker).
SOLANA_ESCROW_IDL_PATH=
# Shared secret for X-Oracle-Token on /escrow/settle and /escrow/resolve; empty disables both endpoints.
SOLANA_ORACLE_TOKEN=
# The clipUSD SPL mint (6 decimals) used by campaign escrow, staking and the bonus pool.
SOLANA_BMONEY_MINT=
SOLANA_BMONEY_DECIMALS=6
