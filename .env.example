SOLANA_ESCROW_PROGRAM_ID=
# The SPL/Token-2022 mint address for bmoney.
SOLANA_BMONEY_MINT=
SOLANA_BMONEY_DECIMALS=6
# Usually the treasury/deployer public key used to approve campaign releases.
SOLANA_ESCROW_RELEASE_AUTHORITY=
