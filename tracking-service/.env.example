# python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-me-owner
TRACKING_APP_DB_PASSWORD=change-me-app
TRACKING_DATABASE_URL=postgresql://tracking_app:change-me-app@postgres:5432/tracking

REDIS_PASSWORD=change-me-redis
TRACKING_REDIS_URL=redis://:change-me-redis@redis:6379/0

# >= 32 characters each
TRACKING_SERVICE_TOKEN=
TRACKING_FINGERPRINT_SECRET=

# public | internal | all
TRACKING_API_ROLE=all

TRACKING_TRUSTED_PROXY_HOPS=0
# required when TRUSTED_PROXY_HOPS > 0
# TRACKING_TRUSTED_PROXIES=["10.0.3.7/32"]
TRACKING_RATE_LIMIT_PER_MINUTE=60
TRACKING_REDIRECT_PREFIX=/r
TRACKING_EXPOSE_DOCS=false
TRACKING_LOG_LEVEL=INFO
