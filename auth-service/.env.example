# waggi auth-service environment. Copy to .env (gitignored) and fill in.
# The compose file reads AUTH_POSTGRES_PASSWORD / AUTH_REDIS_PASSWORD from the
# shell env or a root-level .env; the api service additionally reads this file.

# --- database / redis (compose injects these; set for bare-metal runs) ---
DATABASE_URL=postgresql+asyncpg://waggi_auth:waggi_auth@localhost:5432/waggi_auth
REDIS_URL=redis://localhost:6379/0

# --- JWT signing (generate: python scripts/generate_keys.py) -------------
JWT_PRIVATE_KEY_PATH=./keys/auth_private.pem
JWT_PUBLIC_KEY_PATH=./keys/auth_public.pem
JWT_KEY_ID=waggi-auth-1
JWT_ISSUER=waggi-auth
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# --- TOTP 2FA --------------------------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
MFA_TOKEN_SECRET=
MFA_TOKEN_TTL_MINUTES=5
SETUP_TOKEN_TTL_MINUTES=15

# --- CORS / frontend -------------------------------------------------------
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- WebAuthn (passkeys) ---------------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Waggi
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:4173

# --- SSO (Google / Apple; empty = disabled) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
